{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/app.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ],
  "env": {
    "PIP_REQUIREMENTS_FILE": "requirements.txt",
    "HF_TOKEN": "@hf_token",
    "ASTRA_DB_APPLICATION_TOKEN": "@astra_db_token",
    "ASTRA_DB_API_ENDPOINT": "@astra_db_endpoint",
    "ASTRA_DB_KEYSPACE": "@astra_db_keyspace"
  }
}
