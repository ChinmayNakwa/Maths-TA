{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/app.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ],
  "build": {
    "env": {
      "PIP_REQUIREMENTS_FILE": "requirements.txt",
      "SYSTEM_DEPS": "poppler-utils ffmpeg mesa-libGL"
    }
  }
}